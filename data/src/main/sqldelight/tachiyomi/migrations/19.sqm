CREATE TABLE ocr_exclusion_zones_new(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    manga_id INTEGER NOT NULL,
    source_id INTEGER NOT NULL,
    chapter_id INTEGER,
    page_index INTEGER,
    scope TEXT NOT NULL,
    left_norm REAL NOT NULL,
    top_norm REAL NOT NULL,
    right_norm REAL NOT NULL,
    bottom_norm REAL NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL,
    match_text TEXT,
    match_type TEXT NOT NULL DEFAULT 'ZONE',
    rule_name TEXT,
    FOREIGN KEY(chapter_id) REFERENCES chapters (_id) ON DELETE CASCADE
);
INSERT INTO ocr_exclusion_zones_new(
    _id, manga_id, source_id, chapter_id, page_index, scope,
    left_norm, top_norm, right_norm, bottom_norm, enabled, created_at,
    match_text, match_type, rule_name
)
SELECT
    _id, manga_id, source_id, chapter_id, page_index, scope,
    left_norm, top_norm, right_norm, bottom_norm, enabled, created_at,
    NULL, 'ZONE', NULL
FROM ocr_exclusion_zones;
DROP TABLE ocr_exclusion_zones;
ALTER TABLE ocr_exclusion_zones_new RENAME TO ocr_exclusion_zones;
CREATE INDEX ocr_exclusion_zones_manga_id_index ON ocr_exclusion_zones(manga_id);
UPDATE ocr_exclusion_zones SET chapter_id = NULL WHERE scope IN ('MANGA', 'SOURCE');
